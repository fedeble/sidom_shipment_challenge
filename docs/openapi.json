{
  "openapi": "3.0.0",
  "paths": {
    "/shipments": {
      "post": {
        "description": "Crea un embarque en memoria con contenedores y exactamente una factura comercial y un packing list.",
        "operationId": "createShipment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentDto"
              },
              "examples": {
                "shipment": {
                  "value": {
                    "origin": "Buenos Aires, Argentina",
                    "destination": "Montevideo, Uruguay",
                    "containers": [
                      {
                        "reference": "CONT-001"
                      }
                    ],
                    "documents": [
                      {
                        "type": "COMMERCIAL_INVOICE",
                        "reference": "INV-2026-001"
                      },
                      {
                        "type": "PACKING_LIST",
                        "reference": "PL-2026-001"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Embarque creado con estado CREATED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo no cumple las validaciones o reglas de negocio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado sin detalles internos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Crear un embarque",
        "tags": [
          "shipments"
        ]
      }
    },
    "/shipments/{shipmentId}": {
      "get": {
        "description": "Devuelve el agregado completo, incluidos contenedores, ítems y documentos.",
        "operationId": "getShipment",
        "parameters": [
          {
            "name": "shipmentId",
            "required": true,
            "in": "path",
            "description": "UUID v4 del embarque",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Embarque encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El identificador no es un UUID v4 válido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No existe un embarque con ese identificador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado sin detalles internos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Consultar un embarque",
        "tags": [
          "shipments"
        ]
      }
    },
    "/shipments/{shipmentId}/containers/{containerId}/items": {
      "post": {
        "description": "Agrega un ítem al contenedor indicado y valida su pertenencia al embarque.",
        "operationId": "addCargoItem",
        "parameters": [
          {
            "name": "shipmentId",
            "required": true,
            "in": "path",
            "description": "UUID v4 del embarque",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "containerId",
            "required": true,
            "in": "path",
            "description": "UUID v4 del contenedor",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCargoItemDto"
              },
              "examples": {
                "item": {
                  "value": {
                    "description": "Repuestos industriales",
                    "quantity": 24
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ítem agregado al contenedor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CargoItemResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "El cuerpo o un identificador no es válido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "No existe el embarque o el contenedor no le pertenece.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado sin detalles internos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [],
        "summary": "Agregar un ítem",
        "tags": [
          "shipments"
        ]
      }
    },
    "/liveness": {
      "get": {
        "description": "Confirma que el proceso está atendiendo solicitudes.",
        "operationId": "getLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "El proceso está disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok"
                  }
                }
              }
            }
          },
          "500": {
            "description": "El proceso no pudo atender la solicitud."
          }
        },
        "security": [],
        "summary": "Comprobar disponibilidad del proceso",
        "tags": [
          "health"
        ]
      }
    },
    "/readiness": {
      "get": {
        "description": "Confirma que NestJS y el almacenamiento en memoria están disponibles.",
        "operationId": "getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "La aplicación está lista.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok"
                  }
                }
              }
            }
          },
          "503": {
            "description": "El ShipmentStore no está disponible"
          }
        },
        "security": [],
        "summary": "Comprobar preparación de la aplicación",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Challenge SIDOM - Shipments API",
    "description": "API local para gestionar embarques, contenedores, ítems y documentos aduaneros como metadatos.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "shipments",
      "description": "Operaciones sobre el agregado Shipment"
    },
    {
      "name": "health",
      "description": "Endpoints operativos"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo local"
    }
  ],
  "components": {
    "schemas": {
      "CreateContainerDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "CONT-001",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "required": [
          "reference"
        ]
      },
      "CreateCustomsDocumentDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "COMMERCIAL_INVOICE",
              "PACKING_LIST"
            ],
            "example": "COMMERCIAL_INVOICE"
          },
          "reference": {
            "type": "string",
            "example": "INV-2026-001",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "type",
          "reference"
        ]
      },
      "CreateShipmentDto": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "example": "Buenos Aires, Argentina",
            "minLength": 1,
            "maxLength": 120
          },
          "destination": {
            "type": "string",
            "example": "Montevideo, Uruguay",
            "minLength": 1,
            "maxLength": 120
          },
          "containers": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateContainerDto"
            }
          },
          "documents": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateCustomsDocumentDto"
            }
          }
        },
        "required": [
          "origin",
          "destination",
          "containers",
          "documents"
        ]
      },
      "CargoItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4 generado por el servidor."
          },
          "description": {
            "type": "string",
            "description": "Descripción del ítem."
          },
          "quantity": {
            "type": "number",
            "description": "Cantidad de unidades."
          }
        },
        "required": [
          "id",
          "description",
          "quantity"
        ]
      },
      "ContainerResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4 del contenedor."
          },
          "reference": {
            "type": "string",
            "description": "Referencia externa del contenedor."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CargoItemResponseDto"
            }
          }
        },
        "required": [
          "id",
          "reference",
          "items"
        ]
      },
      "CustomsDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4 del documento."
          },
          "type": {
            "type": "string",
            "enum": [
              "COMMERCIAL_INVOICE",
              "PACKING_LIST"
            ]
          },
          "reference": {
            "type": "string",
            "description": "Referencia del documento aduanero."
          }
        },
        "required": [
          "id",
          "type",
          "reference"
        ]
      },
      "ShipmentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID v4 del embarque."
          },
          "origin": {
            "type": "string",
            "description": "Lugar de origen."
          },
          "destination": {
            "type": "string",
            "description": "Lugar de destino."
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED"
            ],
            "description": "Estado asignado por el servidor."
          },
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContainerResponseDto"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomsDocumentResponseDto"
            }
          }
        },
        "required": [
          "id",
          "origin",
          "destination",
          "status",
          "containers",
          "documents"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "example": [
              "origin must not be empty"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "AddCargoItemDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Repuestos industriales",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "number",
            "example": 24,
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "description",
          "quantity"
        ]
      }
    }
  },
  "externalDocs": {
    "description": "Guía del proyecto",
    "url": "https://github.com/sidom/challenge-embarque#readme"
  }
}
