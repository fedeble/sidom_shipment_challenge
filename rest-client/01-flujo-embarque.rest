@baseUrl = http://127.0.0.1:3000

### 01 - Crear embarque
# @name createShipment
POST {{baseUrl}}/shipments
Content-Type: application/json

{
  "origin": "Buenos Aires, Argentina",
  "destination": "Montevideo, Uruguay",
  "containers": [
    { "reference": "CONT-REST-001" },
    { "reference": "CONT-REST-002" }
  ],
  "documents": [
    { "type": "COMMERCIAL_INVOICE", "reference": "INV-REST-001" },
    { "type": "PACKING_LIST", "reference": "PL-REST-001" }
  ]
}

### 02 - Agregar ítem al segundo contenedor
POST {{baseUrl}}/shipments/{{createShipment.response.body.$.id}}/containers/{{createShipment.response.body.$.containers[1].id}}/items
Content-Type: application/json

{
  "description": "Repuestos industriales",
  "quantity": 24
}

### 03 - Consultar embarque completo
GET {{baseUrl}}/shipments/{{createShipment.response.body.$.id}}

### 04 - Comprobar que el primer contenedor permanece vacío
GET {{baseUrl}}/shipments/{{createShipment.response.body.$.id}}
